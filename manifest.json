{
  "manifest_version": 3,
  "name": "EcoPrompt",
  "version": "1.0.0",
  "description": "Compress your AI prompts. Save energy.",

  "permissions": ["storage", "offscreen", "activeTab", "identity", "scripting"],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],

  "background": {
    "service_worker": "dist/worker.bundle.js"
  },

  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://grok.com/*"
    ],
    "js": ["dist/inject.bundle.js"],
    "run_at": "document_idle"
  }],

  "action": {
    "default_popup": "src/popup/popup.html"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
